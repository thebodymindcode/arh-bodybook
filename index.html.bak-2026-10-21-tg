/* SYSTEMS */
.sys-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:24px 0}
.sys-card{padding:20px 22px;background:rgba(255,255,255,.3);border:1px solid var(--line);transition:all .3s}
