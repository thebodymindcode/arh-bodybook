.sys-num{font-family:'Courier Prime',monospace;font-size:.6rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--red);margin-bottom:2px}
.sys-name{font-family:'Playfair Display',Georgia,serif;font-size:1.1rem;font-weight:700;color:var(--ink);margin-bottom:6px}
.sys-signals{font-size:.88rem;color:var(--ink3);line-height:1.6}
.sys-meta{font-size:.72rem;color:var(--ink4);margin-top:6px;font-weight:600}
.sys-card.rz{background:rgba(180,36,20,.04);border-color:rgba(180,36,20,.2)}
.sys-card.rz:hover{border-color:var(--red)}

/* FORMULA */
.formula{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;padding:20px;background:rgba(255,255,255,.3);border:1px solid var(--line);margin:24px 0;font-family:'Courier Prime',monospace;font-size:.78rem;font-weight:700;color:var(--ink2)}
.f-arr{color:var(--red);font-size:1rem}

/* INCLUDES */
.inc-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin:24px 0}
.inc-card{padding:18px;background:rgba(255,255,255,.3);border:1px solid var(--line);text-align:center}
.inc-card h4{font-family:'Playfair Display',Georgia,serif;font-size:1rem;font-weight:700;color:var(--ink);margin-bottom:4px}
.inc-card p{font-size:.82rem;color:var(--ink3);margin:0;line-height:1.5}

/* BA */
.ba{display:grid;grid-template-columns:1fr 1fr;margin:24px 0;border:1px solid var(--line);overflow:hidden}
.ba-side{padding:24px}
.ba-side.before{background:rgba(180,36,20,.04)}
.ba-side.after{background:rgba(90,122,80,.06)}
.ba-label{font-family:'Courier Prime',monospace;font-size:.6rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;margin-bottom:14px}
.ba-side.before .ba-label{color:var(--red)}
.ba-side.after .ba-label{color:var(--sage)}
.ba-item{padding:10px 0;font-size:.92rem;line-height:1.6;color:var(--ink2);border-bottom:1px solid rgba(0,0,0,.04)}
.ba-item:last-child{border:none}

/* CTA */
.cta-box{background:var(--ink);color:var(--paper);padding:44px;margin:40px 0;text-align:center}
.cta-box h2{color:var(--paper);margin-top:0;font-size:clamp(1.4rem,3vw,1.8rem)}
.cta-price{font-family:'Playfair Display',Georgia,serif;font-size:3.2rem;font-weight:900;color:#fff;margin:12px 0 4px}
.cta-note{font-size:.78rem;color:rgba(239,230,204,.4);margin-bottom:24px}
.cta-btn{display:inline-block;padding:16px 44px;background:var(--red);color:#fff;font-family:'Courier Prime',monospace;font-size:.75rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;transition:all .3s}
.cta-btn:hover{background:var(--red2);box-shadow:0 12px 32px rgba(180,36,20,.3);transform:translateY(-2px)}
.cta-sub{font-size:.7rem;color:rgba(239,230,204,.3);margin-top:14px}

/* FAQ */
.faq-item{border-bottom:1px solid var(--line);padding:16px 0;cursor:pointer}
.faq-q{font-family:'Playfair Display',Georgia,serif;font-size:1.05rem;font-weight:700;color:var(--ink);display:flex;justify-content:space-between;align-items:center}
.faq-q::after{content:'+';font-size:1.2rem;color:var(--ink4);transition:transform .3s}
.faq-item.open .faq-q::after{transform:rotate(45deg);color:var(--red)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .4s}
.faq-item.open .faq-a{max-height:200px}
.faq-a p{padding-top:12px;font-size:.92rem;color:var(--ink3);line-height:1.7;margin:0}

/* COUNTER ROW */
.counter-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:28px 0}
.counter{text-align:center;padding:24px 12px;background:rgba(255,255,255,.3);border:1px solid var(--line)}
.counter-num{font-family:'Playfair Display',Georgia,serif;font-size:2.4rem;font-weight:900;color:var(--red);line-height:1}
.counter-label{font-family:'Courier Prime',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;color:var(--ink4);margin-top:6px}

/* PEEK (book page preview) */
.peek{margin:32px 0;padding:28px;background:rgba(255,255,255,.4);border:1px solid var(--line);position:relative}
.peek::before{content:'Страница из книги';position:absolute;top:-10px;left:20px;font-family:'Courier Prime',monospace;font-size:.6rem;text-transform:uppercase;letter-spacing:.15em;color:var(--red);background:var(--paper);padding:0 10px}
.peek h4{font-family:'Playfair Display',Georgia,serif;font-size:1.1rem;font-weight:700;color:var(--ink);margin-bottom:12px}
.peek-signal{font-family:'Courier Prime',monospace;font-size:.7rem;font-weight:700;color:var(--red);letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px}
.peek p{font-size:.9rem;line-height:1.7;color:var(--ink3);margin-bottom:10px}
.peek-blur{filter:blur(4px);user-select:none;pointer-events:none}
.peek-unlock{text-align:center;padding:16px 0;font-family:'Courier Prime',monospace;font-size:.72rem;font-weight:700;color:var(--red);letter-spacing:.08em}

/* COST SECTION */
.cost-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:24px 0}
.cost-card{padding:20px;text-align:center;border:1px solid var(--line)}
.cost-card.bad{background:rgba(180,36,20,.04);border-color:rgba(180,36,20,.15)}
.cost-card.good{background:rgba(90,122,80,.04);border-color:rgba(90,122,80,.15)}
.cost-num{font-family:'Playfair Display',Georgia,serif;font-size:1.8rem;font-weight:900;line-height:1}
.cost-card.bad .cost-num{color:var(--red)}
.cost-card.good .cost-num{color:var(--sage)}
.cost-text{font-size:.82rem;color:var(--ink3);margin-top:6px;line-height:1.5}

/* NOT IN BOOK */
.not-list{margin:20px 0;font-size:.95rem;line-height:2.2;color:var(--ink3)}
.not-list span{color:var(--sage);font-weight:700;margin-right:8px}

.foot{text-align:center;padding:32px 0;border-top:1px solid var(--line);margin-top:40px;font-family:'Courier Prime',monospace;font-size:.68rem;color:var(--ink4);line-height:2.2}
.foot a{color:var(--ink4);text-decoration:underline;text-underline-offset:2px}

