<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
:root{--bg:#d4c9a8;--paper:#efe6cc;--paper2:#e8dfc4;--ink:#1a1a18;--ink2:#3a3528;--ink3:#5a5040;--ink4:#8a8070;--red:#B42414;--red2:#961410;--sage:#5a7a50;--line:rgba(26,26,24,.1)}
body{font-family:'Source Serif 4',Georgia,serif;background:var(--bg);color:var(--ink2);font-size:17px;line-height:1.8;-webkit-font-smoothing:auto}
::selection{background:var(--red);color:#fff}
body::before{content:'';position:fixed;inset:0;background:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");opacity:.05;pointer-events:none;z-index:10000}

.page{max-width:720px;margin:0 auto;padding:48px 40px 60px;background:linear-gradient(135deg,var(--paper),var(--paper2),var(--paper));box-shadow:0 4px 40px rgba(60,50,20,.15);border:1px solid rgba(100,80,40,.15);position:relative}

/* MASTHEAD */
.masthead{text-align:center;padding:20px 0 28px;border-bottom:3px double var(--ink);margin-bottom:32px}
.masthead-edition{font-family:'Courier Prime',monospace;font-size:.65rem;color:var(--ink4);letter-spacing:.2em;text-transform:uppercase;margin-bottom:16px}
.masthead h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(2.2rem,6vw,3.2rem);font-weight:900;line-height:1.08;color:var(--ink);margin-bottom:14px}
.masthead h1 em{font-style:italic;color:var(--red);font-weight:400}
.masthead-sub{font-family:'Source Serif 4',Georgia,serif;font-size:1.05rem;font-style:italic;color:var(--ink3);max-width:520px;margin:0 auto}
.masthead::after{content:'';display:block;width:100%;height:1px;background:var(--ink);margin-top:28px;opacity:.2}

/* FOMO */
.fomo{display:block;padding:10px 20px;background:rgba(180,36,20,.06);border:1px solid rgba(180,36,20,.2);font-family:'Courier Prime',monospace;font-size:.72rem;font-weight:700;color:var(--red);letter-spacing:.08em;text-transform:uppercase;margin:28px 0;text-align:center}

h2{font-family:'Playfair Display',Georgia,serif;font-size:clamp(1.3rem,3.5vw,1.65rem);font-weight:900;line-height:1.2;text-transform:uppercase;letter-spacing:.04em;margin:36px 0 18px;color:var(--ink)}
h3{font-family:'Playfair Display',Georgia,serif;font-size:1.15rem;font-weight:700;margin:24px 0 12px;color:var(--ink)}
p{margin-bottom:16px;text-align:left}
strong{font-weight:700;color:var(--ink)}
.sep{width:50px;height:1px;background:linear-gradient(90deg,rgba(100,80,40,.3),transparent);margin:40px 0}
.file-tab{font-family:'Courier Prime',monospace;font-size:.68rem;text-transform:uppercase;letter-spacing:.18em;color:var(--ink4);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:8px 0;margin:44px 0 20px}
.pullquote{border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);padding:18px 0;margin:32px 0;text-align:center;font-family:'Playfair Display',Georgia,serif;font-size:1.25rem;font-weight:700;font-style:italic;line-height:1.4;color:var(--ink)}
.voice{padding:18px 22px;background:rgba(180,36,20,.04);border-left:2px solid var(--red);margin:16px 0;font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:1.02rem;line-height:1.7;color:var(--ink2)}

/* BOOK */
.book-wrap{text-align:center;padding:40px 0;margin:32px 0;background:var(--paper2)}
.book-wrap img{max-height:440px;max-width:100%;width:auto;height:auto;margin:0 auto;box-shadow:0 20px 50px rgba(0,0,0,.12);border-radius:3px}

